{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "psyfi_experience_recipe.v1.json",
  "title": "PsyFiExperienceRecipe.v1",
  "type": "object",
  "required": ["id", "schema_version", "substance", "visual_recipe", "safety"],
  "properties": {
    "id": { "type": "string" },
    "schema_version": { "type": "string" },
    "substance": { "type": "string" },
    "valence": { "type": "string", "enum": ["positive", "neutral", "mixed", "negative"] },
    "authority": {
      "type": "object",
      "properties": {
        "motifs": { "type": "string" },
        "parameters": { "type": "string" },
        "source_existence": { "type": "string" }
      }
    },
    "source_refs": { "type": "array", "items": { "type": "object" } },
    "motifs": { "type": "object", "additionalProperties": { "type": "number" } },
    "narrative_hooks": { "type": "array", "items": { "type": "string" } },
    "visual_recipe": { "type": "object" },
    "safety": { "type": "object" }
  }
}
