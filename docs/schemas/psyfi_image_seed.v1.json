{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psyfi.local/schemas/psyfi_image_seed.v1.json",
  "title": "psyfi.image_seed.v1",
  "description": "Pass-1 experience-conditioned image seed for Live Experience / GPU publish.",
  "type": "object",
  "required": ["schema", "master_seed", "influence", "features", "parameter_hints", "note"],
  "properties": {
    "schema": { "const": "psyfi.image_seed.v1" },
    "master_seed": { "type": "integer", "minimum": 0 },
    "influence": { "type": "number", "minimum": 0, "maximum": 1 },
    "substance": { "type": "string" },
    "experience_id": { "type": ["string", "null"] },
    "mode": { "type": "string" },
    "features": {
      "type": "object",
      "properties": {
        "mean_rgb": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "energy": { "type": "number" },
        "contrast": { "type": "number" },
        "edge_density": { "type": "number" },
        "warmth": { "type": "number" },
        "width": { "type": "integer" },
        "height": { "type": "integer" }
      }
    },
    "parameter_hints": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "source_field": {
      "type": ["object", "null"],
      "description": "Luminance plane for Live Experience source-plane blend.",
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "values": { "type": "array" }
      }
    },
    "conditioned_preview_png_base64": {
      "type": ["string", "null"],
      "description": "Small PNG preview only; ephemeral, not stored server-side."
    },
    "conditioned_texture_png_base64": {
      "type": ["string", "null"],
      "description": "Larger conditioned PNG for GPU assets.images data-URL attach."
    },
    "texture_asset": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "recommended": {
      "type": "object",
      "properties": {
        "mode": { "type": "string" },
        "intensity": { "type": "number" },
        "experience_id": { "type": ["string", "null"] },
        "experience_title": { "type": ["string", "null"] },
        "experience_score": { "type": ["number", "null"] }
      }
    },
    "recommended_alternatives": {
      "type": "array",
      "description": "Top-N ranked catalog formula matches (winner first).",
      "items": {
        "type": "object",
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "experience_id": { "type": "string" },
          "title": { "type": ["string", "null"] },
          "mode_default": { "type": ["string", "null"] },
          "score": { "type": "number" }
        }
      }
    },
    "applied_experience_id": { "type": ["string", "null"] },
    "applied_mode": { "type": ["string", "null"] },
    "applied_intensity": { "type": ["number", "null"] },
    "recommend_only": { "type": "boolean" },
    "spatiotemporal_anchors": {
      "type": ["object", "null"],
      "description": "Optional I3 grounding plate echoed on the seed payload."
    },
    "kind": { "type": "string" },
    "note": { "type": "string" }
  }
}
