{
  "name": "@psyfi/gpu-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PsyFi modular WebGPU rendering platform (R3F + Three.js WebGPURenderer)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "vitest run benchmarks",
    "goldens:pixel": "PSYFI_UPDATE_PIXEL_GOLDENS=1 vitest run src/goldens/pixelGolden.test.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
